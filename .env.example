# =============================================================================
# Verdyx - Environment Variables (example)
# =============================================================================
# Copy this file to `.env` and fill in the marked values for local development.
# For production secrets see `.env.production` (template only — inject from a
# secrets manager). NEVER commit a real .env to the repo.
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
PORT=5000
RUST_LOG=info
LOG_LEVEL=info

# Public URL of the frontend; used for CORS. No trailing slash.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8080
# Comma-separated list of allowed CORS origins for the backend services.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# -----------------------------------------------------------------------------
# PostgreSQL (required by docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=verdyx_user
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=verdyx
DATABASE_URL=postgresql://verdyx_user:change-me-strong-db-password@localhost:5432/verdyx
DATABASE_MAX_CONNECTIONS=20
# PROD ONLY: point the app at managed RDS instead of the local postgres
# container. Leave unset for local dev (defaults to the `postgres` service).
# The compose services build their DATABASE_URL from these.
#   POSTGRES_HOST=verdyx-postgres.xxxx.us-east-1.rds.amazonaws.com
#   POSTGRES_PORT=5432
#   POSTGRES_ADMIN_DB=verdyx   # default DB used by ensure-databases.sh

# -----------------------------------------------------------------------------
# Redis (required by docker-compose)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@localhost:6379
# PROD ONLY: point the app at managed ElastiCache. Leave unset for local dev
# (defaults to the `redis` service).
#   REDIS_HOST=verdyx-redis.xxxx.cache.amazonaws.com

# -----------------------------------------------------------------------------
# Authentication / security
# JWT_SECRET MUST be >= 32 chars in production. Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_HOURS=12
SESSION_EXPIRY=604800000
# Use 12 in production (matches docker-compose / K8s / Ansible). Dev/test may lower this.
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Blockchain
# -----------------------------------------------------------------------------
# Local hardhat default for development. Override per environment.
CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://localhost:8545
ETH_PROVIDER_URL=http://localhost:8545
# Deployed contract addresses — leave blank locally to disable blockchain
# integration, the services fall back to no-op behavior.
THREAT_TOKEN_ADDRESS=
REPUTATION_SYSTEM_ADDRESS=
BOUNTY_MANAGER_ADDRESS=
PAYMENT_CONTRACT_ADDRESS=
STAKING_CONTRACT_ADDRESS=
REWARD_CONTRACT_ADDRESS=
TREASURY_ADDRESS=
# TREASURY_PRIVATE_KEY controls real funds in production. NEVER commit it.
TREASURY_PRIVATE_KEY=
# Signer used by the bounty-manager keeper to submit resolveBounty() txs and by
# the sync service. Leave blank locally to disable the keeper/sync/withdrawal API.
BLOCKCHAIN_PRIVATE_KEY=
# Contract ABI files. Required for the bounty-manager to call methods by name
# (resolveBounty, pendingWithdrawals, approve, transfer). Point these at the
# compiled ABI JSON (bare ABI array or a Hardhat artifact with an "abi" field).
BOUNTY_MANAGER_ABI_PATH=
THREAT_TOKEN_ABI_PATH=

# -----------------------------------------------------------------------------
# S3 / object storage  (use MinIO locally, AWS S3 in production)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=verdyx_admin
MINIO_ROOT_PASSWORD=change-me-minio-password
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=verdyx-uploads
# For MinIO local dev set AWS_ENDPOINT_URL=http://localhost:9000
AWS_ENDPOINT_URL=

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=change-me-generate-with-openssl-rand-hex-32
WEBHOOK_TIMEOUT=30
MAX_RETRY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# IPFS (optional, currently disabled)
# -----------------------------------------------------------------------------
IPFS_GATEWAY=https://ipfs.infura.io:5001
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# -----------------------------------------------------------------------------
# Email / SMTP (AWS SES or any provider)
# -----------------------------------------------------------------------------
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_USERNAME=your-ses-smtp-username
SMTP_PASSWORD=your-ses-smtp-password
EMAIL_FROM=noreply@verdyx.io
AWS_SES_REGION=us-east-1

# -----------------------------------------------------------------------------
# Monitoring & logging
# -----------------------------------------------------------------------------
SENTRY_DSN=
# Alertmanager delivery (profile: monitoring). The Slack webhook itself is NOT
# set here — write it to monitoring/alertmanager/secrets/slack_api_url (gitignored).

# -----------------------------------------------------------------------------
# Edge TLS reverse proxy (profile: edge — Caddy, automatic Let's Encrypt)
# -----------------------------------------------------------------------------
DOMAIN=verdyx.duckdns.org
ACME_EMAIL=admin@verdyx.io

# -----------------------------------------------------------------------------
# Off-site DB backups (profile: backup). Leave BACKUP_S3_BUCKET empty to keep
# local-only dumps; set it to also push each verified dump to S3/MinIO.
# BACKUP_S3_ENDPOINT defaults to AWS_ENDPOINT_URL (MinIO) or real AWS S3.
# -----------------------------------------------------------------------------
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pg
BACKUP_S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Malware analysis
# -----------------------------------------------------------------------------
# Compose: host=clamav (container name). Local: host=localhost.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# YARA rules directory
YARA_RULE_PATH=./rules
# Temporary upload directory
UPLOAD_DIR=./temp/verdyx-uploads

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
ENABLE_BLOCKCHAIN=false
ENABLE_IPFS=false
ENABLE_EMAIL=true
ENABLE_CLAMAV=true

# -----------------------------------------------------------------------------
# External analysis API keys (optional)
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=

# -----------------------------------------------------------------------------
# Development tools (only used when running the `dev-tools` compose profile)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@verdyx.io
PGADMIN_PASSWORD=change-me-pgadmin-password

# ---------------------------------------------------------------------------
# Delayed verdict grading (consensus-service)
# ---------------------------------------------------------------------------
# A finalized consensus is what the crowd believed, not what was true. The
# regrader re-scans the sample after GRADING_DELAY_HOURS and records the result
# in verdict_grades; held-back payouts and reputation settle against that.
#
# Off by default because it moves money. When testing the loop, set the delay
# to a few minutes rather than waiting 30 days.
GRADING_ENABLED=false
GRADING_DELAY_HOURS=720          # 30 days
GRADING_POLL_INTERVAL_SECS=3600
GRADING_BATCH_SIZE=50
GRADING_RESCAN_TIMEOUT_SECS=120

# ---------------------------------------------------------------------------
# Commit-reveal voting (consensus-service)
# ---------------------------------------------------------------------------
# With open voting a late voter can read the running tally and copy whoever is
# ahead, so twenty "independent" analysts become one opinion echoed nineteen
# times. Commit-reveal fixes that: commit sha256(bounty:engine:verdict:conf:salt)
# first, publish the plaintext after the window shuts.
#
# NOTE: enabling this CLOSES the direct vote endpoint. Leaving it open would let
# anyone skip the commitment and vote in the clear, defeating the mechanism.
COMMIT_REVEAL_ENABLED=false
COMMIT_WINDOW_HOURS=24
REVEAL_WINDOW_HOURS=24
MIN_SALT_LEN=16
