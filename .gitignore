/target
backend/target/

# Environment variables (contains sensitive data)
.env
.env.local
.env.*.local
.env.blockchain
.env.production
.env.*
!.env.example
!.env.*.example
blockchain/.env
backend/.env
backend/**/.env
config/**/*.env

# CI: per-service test DATABASE_URLs written by scripts/ci/setup-test-databases.sh
.ci-test-db-env

# Alertmanager delivery secrets (Slack webhook, SMTP password). Keep the dir
# (.gitkeep) but never commit the secret files themselves.
monitoring/alertmanager/secrets/*
!monitoring/alertmanager/secrets/.gitkeep

# Node modules
node_modules/
blockchain/node_modules/
frontend/node_modules/

# Build outputs
dist/
build/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Terraform (provider binaries, local/crash state — never commit these)
# Note: .terraform.lock.hcl IS committed intentionally (dependency lock).
**/.terraform/*
*.tfstate
*.tfstate.*
errored.tfstate
crash.log
crash.*.log

# ML service (Python)
ml/.venv/
__pycache__/
*.pyc
.pytest_cache/
# Trained model bundles and EMBER data stay out of git (large, and the data has its own licence)
ml/bundle/
ml-models/

# Benchmark runs (large; the public summary lives in frontend/client/src/data/benchmark.json)
backend/analysis-engine/benchmark/results/report.*
backend/analysis-engine/benchmark/results/run.json
