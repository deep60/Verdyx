# Copy to /opt/verdyx-worker/.env on the A1 worker (setup.sh does this).

# The worker's private IP in the VCN (Instance details → Primary VNIC →
# Private IPv4 address), e.g. 10.0.0.42. Services bind to this address only.
WORKER_PRIVATE_IP=

# The main VM's private IP. setup.sh only lets this address reach ClamAV and
# the ML service.
MAIN_PRIVATE_IP=

# Shared secret between the main VM's analysis engine and the ML service.
# Generate with: openssl rand -hex 32. Put the same value in the main VM's .env.
ML_SERVICE_TOKEN=

# Files the ML service scores at once.
ML_MAX_CONCURRENT=2
