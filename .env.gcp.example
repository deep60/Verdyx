# Verdyx — environment for the free-tier deployment (docker-compose.gcp.yml).
#
# Copy to `.env` ON THE VM (not in git) and fill in the marked values:
#   cp .env.gcp.example .env && chmod 600 .env
#
# Values marked <<FILL>> have no safe default and the stack will not start
# without them, because ENVIRONMENT=production below makes the shared
# credential helper refuse to fall back to dev defaults (backend/shared/src/env.rs).
#
# Generate every secret with:  openssl rand -hex 32

# ── Core ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
NODE_ENV=production
# `warn` rather than `info`: on a shared-core VM, log volume is real CPU and
# real disk. Raise to info temporarily when debugging.
RUST_LOG=warn
LOG_LEVEL=warn

# ── Public URLs ───────────────────────────────────────────────────────────
# DOMAIN is the API host on this VM — the name Caddy gets a certificate for.
# It is NOT where the site lives; the site is the Cloudflare Pages URL below.
DOMAIN=<<FILL: verdyx-api.duckdns.org>>
ACME_EMAIL=<<FILL: your-email@example.com>>

# The Pages deployment. Used for CORS and for any absolute links the backend
# generates (password-reset emails, etc.).
FRONTEND_URL=<<FILL: https://verdyx.pages.dev>>
CORS_ALLOWED_ORIGINS=<<FILL: https://verdyx.pages.dev>>
API_URL=https://<<FILL: same as DOMAIN>>

# ── Postgres (Neon, free tier) ────────────────────────────────────────────
# Take the connection string from the Neon dashboard and strip BOTH the
# trailing `/dbname` and the `?sslmode=...` query. Compose appends the correct
# per-service database name and sslmode itself — each service owns its own
# database, so a single URL here would point them all at the same one.
#
# Neon gives you:  postgresql://USER:PASS@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require
# You want:        postgresql://USER:PASS@ep-xxx-yyy.region.aws.neon.tech
PG_BASE_URL=<<FILL: postgresql://user:pass@ep-xxxx.region.aws.neon.tech>>

# 9 services x 3 connections = 27, comfortably inside Neon's free limit while
# leaving headroom for psql. The stock value of 20 would mean 180 and fail.
DATABASE_MAX_CONNECTIONS=3

# ── Redis (local container) ───────────────────────────────────────────────
# Local, not managed: the `redis` crate is compiled without a TLS feature, so
# it cannot connect to Upstash or any other `rediss://` provider.
REDIS_PASSWORD=<<FILL: openssl rand -hex 32>>

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=<<FILL: openssl rand -hex 32>>
JWT_EXPIRY_HOURS=12
SESSION_EXPIRY=604800000
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
WEBHOOK_SIGNING_SECRET=<<FILL: openssl rand -hex 32>>

# ── Object storage (Cloudflare R2, free 10 GB) ────────────────────────────
# R2 is S3-compatible and the client already supports an endpoint override with
# path-style addressing, so no code changes are needed. Region must be `auto`.
# Create both buckets in the R2 dashboard BEFORE first boot — the startup path
# tries to create a missing bucket, which an API token scoped to Object
# Read/Write is not allowed to do.
S3_ENDPOINT=<<FILL: https://<account-id>.r2.cloudflarestorage.com>>
S3_REGION=auto
S3_BUCKET=verdyx-submissions
S3_AVATAR_BUCKET=verdyx-avatars
S3_ACCESS_KEY=<<FILL: R2 access key id>>
S3_SECRET_KEY=<<FILL: R2 secret access key>>
# Public base URL for avatars. Set this to the bucket's r2.dev public URL (or a
# custom domain) — WITHOUT it, avatar links point at the private S3 endpoint
# and render broken.
S3_PUBLIC_URL=<<FILL: https://pub-xxxx.r2.dev>>

# ── Email (optional) ──────────────────────────────────────────────────────
# Set ENABLE_EMAIL=false to skip entirely; registration still works, only
# verification/notification mail is suppressed. Resend and Brevo both have free
# tiers that work here.
ENABLE_EMAIL=false
# REQUIRED for password reset: production never exposes reset links outside email,
# so without SMTP users can't recover their accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@verdyx.io

# ── Feature flags ─────────────────────────────────────────────────────────
# ClamAV is OFF and must stay off: its signature database alone needs ~1.5 GB,
# more than this whole VM has. The analyzer skips itself cleanly when disabled.
ENABLE_CLAMAV=false
ENABLE_BLOCKCHAIN=false
ENABLE_IPFS=false

# ── Blockchain ────────────────────────────────────────────────────────────
# Sepolia testnet. These stay placeholders until real contracts are deployed;
# with ENABLE_BLOCKCHAIN=false the services degrade gracefully rather than
# crashlooping when the RPC is unreachable.
CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETH_PROVIDER_URL=https://ethereum-sepolia-rpc.publicnode.com
THREAT_TOKEN_ADDRESS=
REPUTATION_SYSTEM_ADDRESS=
BOUNTY_MANAGER_ADDRESS=
PAYMENT_CONTRACT_ADDRESS=
TREASURY_ADDRESS=
TREASURY_PRIVATE_KEY=
BLOCKCHAIN_PRIVATE_KEY=

# ── Analysis ──────────────────────────────────────────────────────────────
YARA_RULE_PATH=/app/rules
UPLOAD_DIR=/tmp/verdyx-uploads
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=
# Free key from https://auth.abuse.ch; MalwareBazaar rejects requests without one.
ABUSE_CH_API_KEY=
SENTRY_DSN=

# ---- Rate limiting ----
# Same random value here and as a secret on the Cloudflare Pages project
# (generate: openssl rand -hex 32). Without it, everyone arriving through Pages
# can share a Cloudflare IP and therefore a single login rate limit.
EDGE_PROXY_SECRET=
# Login, registration and password reset requests per client IP per 15 minutes.
AUTH_RATE_LIMIT_PER_15_MIN=30
